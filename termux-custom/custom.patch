+    /**
+     * $HOME lives in shared storage, so make sure it exists and keep the old hardcoded
+     * path (files/home, used by scripts like etc/profile) pointing to it.
+     *
+     * @return {@code true} if $HOME exists and is writable, {@code false} if storage permission is missing.
+     */
+    static boolean ensureHomeDirectory() {
+        final String LOG_TAG = "termux-home";
+        File home = TermuxConstants.TERMUX_HOME_DIR;
+        if (!home.isDirectory()) home.mkdirs();
+        boolean homeUsable = home.isDirectory() && home.canWrite();
+
+        File legacyHome = new File(TermuxConstants.TERMUX_FILES_DIR_PATH, "home");
+        try {
+            try {
+                StructStat stat = Os.lstat(legacyHome.getAbsolutePath());
+                if (OsConstants.S_ISLNK(stat.st_mode)) return homeUsable;
+                // Keep a real old home that still has user data in it.
+                String[] children = legacyHome.list();
+                if (children == null || children.length > 0) return homeUsable;
+                legacyHome.delete();
+            } catch (ErrnoException e) {
+                // Old home does not exist yet.
+            }
+            Os.symlink(home.getAbsolutePath(), legacyHome.getAbsolutePath());
+        } catch (Exception e) {
+            Logger.logStackTraceWithMessage(LOG_TAG, "Could not link old home path to " + home.getAbsolutePath(), e);
+        }
+        return homeUsable;
+    }
